# Copy to scripts/deploy.env and adjust; used by scripts/deploy-vm.sh.
VC_DEPLOY_HOST=my-server          # ssh host (alias from ~/.ssh/config works)
VC_PUBLIC_IP=203.0.113.10         # address clients reach for voice
VC_PRIVATE_IP=0.0.0.0             # address to bind (the private IP behind a cloud NAT)
# VC_TEAMSPEAK=0                  # disable the TeamSpeak bridge
