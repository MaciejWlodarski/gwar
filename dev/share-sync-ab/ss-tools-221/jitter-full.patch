+    /// Gwar: whether the cluster arrived mostly as fast as it was sent, and only a few long
+    /// gaps between its packets lowered its receive rate. A full link spaces every packet out
+    /// alike; jitter on the way holds a run of them back and lets them go together.
+    fn stretched(&self) -> bool {
+        let (Some(first), Some(last)) = (self.first_send_time, self.last_send_time) else {
+            return false;
+        };
+        let send_size = self.total_bytes.saturating_sub(self.size_last_send);
+        let send_interval = last.saturating_duration_since(first);
+        let recv_size = self.total_bytes.saturating_sub(self.size_first_receive);
+        if self.recv_times.len() < MIN_CLUSTER_SIZE || send_interval.is_zero() || send_size <= DataSize::ZERO {
+            return false;
+        }
+        let mut times = self.recv_times.clone();
+        times.sort_unstable();
+        let mut gaps: Vec<Duration> = times.windows(2).map(|w| w[1] - w[0]).collect();
+        gaps.sort_unstable();
+        let typical = gaps[gaps.len() / 2];
+        if typical.is_zero() {
+            return true;
+        }
+        let packet = recv_size.as_bytes_f64() / gaps.len() as f64;
+        let dense = DataSize::bytes(packet as i64) / typical;
+        dense.as_f64() >= (send_size / send_interval).as_f64() * MIN_RATIO_FOR_UNSATURATED_LINK
+    }
