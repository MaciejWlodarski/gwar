<?xml version="1.0" encoding="utf-8"?>
<!-- The device identity must not leave the device through cloud backup or transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
