+/// EXPERIMENT (variant 2): rates measured from the end of the first send burst to the end of
+/// the last, over the bytes sent after the first burst. Exact for a backlogged bottleneck,
+/// and both ends are the last arrival of a burst, so FIFO jitter biases neither.
+fn group_rates(p: &[(Instant, Instant, usize)], first_send: Instant) -> Option<(Bitrate, Bitrate)> {
+    let edge = first_send + Duration::from_millis(1);
+    let g1_send = p.iter().filter(|x| x.0 <= edge).map(|x| x.0).max()?;
+    let g1_recv = p.iter().filter(|x| x.0 <= edge).map(|x| x.1).max()?;
+    let rest: Vec<_> = p.iter().filter(|x| x.0 > edge).collect();
+    if rest.len() < 2 {
+        return None;
+    }
+    let bytes = DataSize::bytes(rest.iter().map(|x| x.2 as i64).sum());
+    let last_send = rest.iter().map(|x| x.0).max()?;
+    let last_recv = rest.iter().map(|x| x.1).max()?;
+    let si = last_send.checked_duration_since(g1_send)?;
+    let ri = last_recv.checked_duration_since(g1_recv)?;
+    if si.is_zero() || ri.is_zero() {
+        return None;
+    }
+    Some((bytes / ri, bytes / si))
+}
